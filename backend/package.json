{
  "name": "opal-line-server",
  "private": true,
  "version": "0.1.0",
  "type": "commonjs",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --max-warnings 0",
    "test": "node --import tsx --test --test-concurrency=1 --test-force-exit \"src/**/*.test.ts\"",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx src/db/seed.ts",
    "auth:reset": "tsx scripts/reset-admin-password.ts"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "aws4fetch": "^1.0.20",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^18.0.8",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "imapflow": "^2.5.5",
    "mailparser": "^3.9.46",
    "nodemailer": "^10.0.1",
    "pdfkit": "^0.20.2",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "qs": "^6.16.1",
    "resend": "^6.34.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.7",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "oxlint": "^1.89.0"
  }
}
