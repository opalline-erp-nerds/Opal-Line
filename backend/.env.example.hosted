# Hosted mode (Render + Supabase). Placeholders only.
# Copy values into the host's environment. Do not put this file's contents
# into backend/.env on a desktop machine — an absent HOST leaves the
# desktop app on 127.0.0.1 exactly as today.
#
# Use a scratch Supabase project, not a database that has real orders.

# Render sets PORT. Do not use 47191–47198 (those belong to desktop, dev, and local Docker).
HOST=0.0.0.0
NODE_ENV=production
TRUST_PROXY=1
# Session cookie. Leave both unset on the desktop app.
COOKIE_SECURE=true
# COOKIE_SAMESITE=Strict

# Session pooler (port 5432) or the direct host. Do not use the transaction
# pooler (port 6543): this app uses prepared statements and LISTEN.
# Session pooler example:
# postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
# Direct example (often IPv6-only unless the project has an IPv4 add-on):
# postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# 64 hex characters. Required once the process listens on 0.0.0.0 (enforced in a later step).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS
CSRF_SECRET=CHANGE_ME_LONG_RANDOM

# First-boot admin password (username admin). Bootstrap forces a change at first login.
# Do not run `npm run db:seed` on this database — that loads demo data.
SEED_ADMIN_PASSWORD=CHANGE_ME_LONG_RANDOM

# Optional. Omit it while the API serves the UI (same origin, relative /api/v1).
# Set it only when the static site is on a different origin.
# FRONTEND_ORIGIN=https://app.example.com

# Process cwd is backend/, so this points at <repo>/frontend/dist.
FRONTEND_DIST=../frontend/dist

# Public https origin of this service, no trailing slash.
# Webhooks are registered at ${PUBLIC_BASE_URL}/api/v1/webhooks/shopify
PUBLIC_BASE_URL=https://opal-line.example.onrender.com
SHOPIFY_STORE_URL=your-store
SHOPIFY_ACCESS_TOKEN=shpat_CHANGE_ME
SHOPIFY_API_VERSION=2025-10
SHOPIFY_WEBHOOK_SECRET=CHANGE_ME

# Optional. Leave empty until that feature is needed.
RESEND_API_KEY=
NOTIFICATION_EMAIL=
EMAIL_FROM=
ORDER_EMAIL_ADDRESS=
ORDER_EMAIL_PASSWORD=
ORDER_EMAIL_HOST=
ORDER_EMAIL_PORT=
ORDER_EMAIL_FOLDER=
ORDER_EMAIL_PROVIDER=
SILVER_RATE_API_URL=
SILVER_RATE_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
BACKUP_DIR=
BACKUP_OFFSITE_ENDPOINT=
BACKUP_OFFSITE_BUCKET=
BACKUP_OFFSITE_KEY_ID=
BACKUP_OFFSITE_SECRET=
BACKUP_OFFSITE_PREFIX=
BACKUP_OFFSITE_REGION=
